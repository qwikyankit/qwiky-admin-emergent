{
  "expo": {
    "name": "Meroha Admin",
    "slug": "qwiky-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/meroha-icon.png",
    "scheme": "qwiky-admin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qwiky.admin"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/meroha-icon.png",
        "backgroundColor": "#463129"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.qwiky.admin"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/meroha-icon.png",
      "name": "Meroha Admin",
      "shortName": "Meroha Admin",
      "description": "Meroha booking management",
      "themeColor": "#463129",
      "backgroundColor": "#F7F0E8",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/meroha-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F0E8"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
